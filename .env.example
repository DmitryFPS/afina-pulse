# --- Telegram MTProto (нужны для живого QR) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Afina Relay / Telegram ---
WATCH_KAFKA_BOOTSTRAP=127.0.0.1:9092
WATCH_KAFKA_TOPIC=relay.events
WATCH_MONGO_URI=mongodb://127.0.0.1:27017
WATCH_MONGO_DB=relay
WATCH_RELAY_API=http://127.0.0.1:8090

# --- Facebook Graph (pages you admin) ---
WATCH_FB_APP_ID=
WATCH_FB_APP_SECRET=
WATCH_FB_PAGE_TOKENS=          # comma-separated page_id:token

# Browser collector is OFF unless you explicitly enable it.
WATCH_FB_BROWSER_ENABLED=false

# --- Local LLM ---
WATCH_OLLAMA_HOST=http://127.0.0.1:11434
WATCH_LLM_MODEL=qwen2.5:7b
WATCH_VLM_MODEL=qwen2.5vl:7b
WATCH_EMBED_MODEL=bge-m3
WATCH_WHISPER_MODEL=medium
WATCH_WHISPER_DEVICE=cuda      # cuda | cpu | auto

# --- Alerts ---
WATCH_ALERT_TG_BOT_TOKEN=
WATCH_ALERT_TG_CHAT_ID=
WATCH_ALERT_WEBHOOK=

# --- Store ---
WATCH_DB_PATH=./data/watch.sqlite
WATCH_MEDIA_CACHE=./data/media
WATCH_LOG_LEVEL=INFO
